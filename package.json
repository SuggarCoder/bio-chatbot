{
  "name": "bio-chatbot",
  "version": "1.0.0",
  "description": "A chatbot for biotech, powered by solidjs and fastify",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k -n WEB,API \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "cross-env SERVE_CLIENT=false tsx watch src/server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "test": "tsx --test src/server/*.test.ts src/server/artifacts/*.test.ts src/server/storage/*.test.ts src/client/features/chatbot/*.test.ts src/client/features/artifacts/*.test.ts",
    "test:storage": "tsx --test src/server/storage/*.integration.ts",
    "test:artifact-integration": "tsx --test src/server/artifacts/*.integration.ts",
    "test:artifact-security": "playwright test tests/artifact-security.spec.ts tests/chat-navigation.spec.ts",
    "storage:check": "tsx src/server/storageCheck.ts",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "build": "npm run check && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuggarCoder/bio-chatbot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/SuggarCoder/bio-chatbot/issues"
  },
  "homepage": "https://github.com/SuggarCoder/bio-chatbot#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/lib-storage": "^3.1101.0",
    "@fastify/static": "^10.1.0",
    "@solidjs/router": "^0.16.1",
    "dompurify": "^3.4.12",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "gsap": "^3.15.0",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.7",
    "mermaid": "^11.16.0",
    "openai": "^7.1.0",
    "pg": "^8.22.0",
    "redis": "^6.1.0",
    "resumable-stream": "^2.2.12",
    "solid-js": "^1.9.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.117",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@unocss/preset-icons": "^66.7.5",
    "@unocss/reset": "^66.7.5",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "unocss": "^66.7.5",
    "vite": "^8.1.4",
    "vite-plugin-solid": "^2.11.12"
  }
}
