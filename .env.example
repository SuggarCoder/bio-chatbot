NODE_ENV=development
HOST=0.0.0.0
PORT=8090
SERVE_CLIENT=true

DATABASE_URL=postgresql://chatbot:change-me@127.0.0.1:5432/gpas2_chatbot
PG_POOL_MAX=16
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=gpas2cb:dev:v3:
# Dedicated disposable Redis database used only by `npm run test:queue-redis`.
TEST_REDIS_URL=redis://127.0.0.1:6379/15

QWEN_API_KEY=replace-with-token-plan-api-key
QWEN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.6-flash
# Used by direct local Node.js runs. Production Compose fixes this path under
# its read-only /home/lu/models -> /app/models bind mount.
# Required for plain chat too: final input budget checks are always enabled.
QWEN_TOKENIZER_PATH=models/qwen-tokenizer
QWEN_CONTEXT_WINDOW_TOKENS=1000000
QWEN_MAX_INPUT_TOKENS=991808
QWEN_MAX_OUTPUT_TOKENS=40960

# Context budgeting and asynchronous memory. Keep feature flags disabled until
# the forward migration, tokenizer assets, and maintenance worker are deployed.
CHAT_HISTORY_TOKEN_BUDGET=131072
CHAT_SUMMARY_TOKEN_BUDGET=8192
SUMMARY_TRIGGER_TOKENS=16384
INSTRUCTIONS_TOKEN_BUDGET=32768
CONTEXT_MEMORY_ENABLED=false
USER_MEMORY_ENABLED=false

BACKGROUND_MODEL=qwen3.6-flash
BACKGROUND_MAX_OUTPUT_TOKENS=4096
BACKGROUND_CONCURRENCY=2
BACKGROUND_TIMEOUT_MS=120000

ARTIFACT_PROTOCOL_TOKEN_BUDGET=4096
ARTIFACT_OUTLINE_TOKEN_BUDGET=8192
ARTIFACT_FRAGMENT_TOKEN_BUDGET=16384
ARTIFACT_CONTEXT_V2_ENABLED=false
ARTIFACT_PATCH_ENABLED=false
# Used by direct local Node.js runs; production Compose uses /app/models.
# Required by API semantic intent routing even when Artifact context is disabled.
EMBEDDING_MODEL_PATH=models/bge-small-zh-v1.5

# Local development: no GPAS2 Cookie or upstream service is required.
GPAS2_AUTH_MODE=mock

# Production must set NODE_ENV=production and GPAS2_AUTH_MODE=upstream.
# GPAS2_AUTH_MODE=mock is rejected when NODE_ENV=production.
GPAS2_USER_INFO_URL=https://gpas.example.invalid/api/gpas2/v1/user/info
# Project APIs use the same origin and /api/gpas2/v1/ prefix as USER_INFO_URL.
# USER_INFO_URL must end with /user/info (an optional trailing slash is accepted).
# In mock mode, projects start uninitialized and reset when the API restarts.
# Test-only escape hatch for a self-signed GPAS2 endpoint. Setting this to 0
# disables TLS verification for every HTTPS request made by the Node process.
NODE_TLS_REJECT_UNAUTHORIZED=1

# Per authenticated user; client IP is not part of the rate-limit key.
CHAT_RATE_LIMIT_PER_MINUTE=10
MONTHLY_TOKEN_LIMIT=0
GLOBAL_GENERATION_CONCURRENCY=80
PROVIDER_GENERATION_CONCURRENCY=80
MODEL_GENERATION_CONCURRENCY=80
GENERATION_TIMEOUT_MS=180000
GENERATION_LOCK_LEASE_MS=30000
GENERATION_LOCK_RENEW_INTERVAL_MS=10000
GENERATION_CANCEL_POLL_INTERVAL_MS=5000
GENERATION_SNAPSHOT_INTERVAL_MS=1000

# SeaweedFS S3 Gateway. Keep disabled until the private bucket and IAM
# credentials have been configured. Deployment creates S3_BUCKET when missing
# using separate Admin credentials. Containers must use a container-reachable
# endpoint instead of 127.0.0.1. When enabled, run
# `npm run storage:check` before deployment and require objectStorage=ok from
# `/ai-chatbot/api/health`.
OBJECT_STORAGE_ENABLED=false
ARTIFACT_PROTOCOL_ENABLED=false
S3_ENDPOINT=http://127.0.0.1:8333
# Production-only opt-in for an HTTP endpoint on the same private host/network.
S3_ALLOW_INSECURE_HTTP=false
S3_REGION=us-east-1
S3_BUCKET=bio-chatbot-artifacts-dev
S3_ACCESS_KEY_ID=replace-with-seaweedfs-access-key
S3_SECRET_ACCESS_KEY=replace-with-seaweedfs-secret-key
# Used only by the one-off deployment bucket initializer.
S3_ADMIN_ACCESS_KEY_ID=replace-with-seaweedfs-admin-access-key
S3_ADMIN_SECRET_ACCESS_KEY=replace-with-seaweedfs-admin-secret-key
S3_FORCE_PATH_STYLE=true
S3_MAX_ATTEMPTS=3
# Set to AES256 only when SeaweedFS server-side encryption is configured.
S3_SERVER_SIDE_ENCRYPTION=

# Required stable secret, shared by all API instances; never commit the real key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
REQUEST_ENCRYPTION_KEY=
# Sized for 100 users x 3 concurrent chats against a 100-concurrency LLM quota.
# Keep GLOBAL_GENERATION + PLANNER x API instances + BACKGROUND x workers <= UPSTREAM
# (80 + 16 + 2 = 98) so no caller waits on the shared permit; excess chats queue fairly.
# Per-user concurrency comes from "User"."generationConcurrencyLimit" (default 3).
# Seconds to cache GPAS identity + user row per session cookie; 0 disables.
AUTH_CACHE_TTL_SECONDS=30
# Durable admission processors per API, and planner requests per API.
INGRESS_CONCURRENCY=24
PLANNER_CONCURRENCY=16
# Shared Redis budget for ALL planner / generation / background model calls.
UPSTREAM_CONCURRENCY=100
# 0 disables RPM enforcement; set to the real provider quota before ramp-up.
UPSTREAM_REQUESTS_PER_MINUTE=0
# Conservative rolling 60s input-byte + maximum-output reservations; 0 = off.
# Shares the same Redis budget across all model callers; may underutilize quota.
UPSTREAM_TOKENS_PER_MINUTE=0
