# Serve the Chatbot under the same HTTPS origin as GPAS2 so the browser sends
# the existing GPAS2 session Cookie to /ai-chatbot/api/*.
#
# The upstream block goes in the http context (e.g. /etc/nginx/conf.d/);
# the locations go in the HTTPS server block for the GPAS2 host. TLS remains
# terminated by the existing GPAS2 gateway.
#
# Two API instances (compose services app and app-2). During a rolling
# deploy one of them restarts; nginx sends new requests to the other one.
# Generation streams live in Redis, so a stream can resume on either.

upstream ai_chatbot_api {
    server 10.88.20.19:8090 max_fails=2 fail_timeout=10s;
    server 10.88.20.19:8091 max_fails=2 fail_timeout=10s;
    keepalive 32;
}

location = /ai-chatbot {
    return 308 /ai-chatbot/;
}

location /ai-chatbot/ {
    proxy_pass http://ai_chatbot_api;
    proxy_http_version 1.1;
    # Needed for upstream keepalive.
    proxy_set_header Connection "";

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Cookie $http_cookie;

    # Try the other instance when one is restarting. POST and other
    # non-idempotent requests are only retried if they never reached the
    # first instance (connection refused), which is nginx's default.
    proxy_next_upstream error timeout http_502;
    proxy_next_upstream_tries 2;
    proxy_connect_timeout 3s;

    # Required for SSE and resumable generation streams.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 10m;
    proxy_send_timeout 10m;
}
